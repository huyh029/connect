  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966675019}
  - {fileID: 114350483966675020}
  - {fileID: 114350483966675021}
  - {fileID: 114350483966675022}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675018}
  m_BlockName: Custom HLSL
  m_HLSLCode: 'void PlayCache(inout VFXAttributes attributes, in VFXSampler2D positionCache,
    in VFXSampler2D sizeCache, in VFXSampler2D rotationCache, in VFXSampler2D colorCache)

    {

    uint
    id = attributes.particleId % 1u; uint frame = min((uint)(attributes.age * 30.0),
    179u);

    int3 uv = int3(id % 1u, id / 1u + frame * 1u, 0);

    float4 p =
    positionCache.t.Load(uv); float4 s = sizeCache.t.Load(uv); float4 r = rotationCache.t.Load(uv);
    float4 c = colorCache.t.Load(uv);

    attributes.position = p.xyz; attributes.size
    = 1; attributes.scaleX = s.x; attributes.scaleY = s.y; attributes.scaleZ = s.z;

    attributes.angleX
    = r.x; attributes.angleY = r.y; attributes.angleZ = r.z; attributes.color = c.rgb;
    attributes.alpha = attributes.age < 6 ? c.a * p.w : 0;

    }'
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: PlayCache
    selectedIndex: 0
